{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "patycord",
  "version": "0.1.1",
  "identifier": "com.patycord.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "patycord",
        "width": 1040,
        "height": 600,
        "minWidth": 760,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://*.peerjs.com wss://*.peerjs.com https://github.com https://objects.githubusercontent.com https://*.githubusercontent.com; media-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4RUMyN0JBRkM4RDFCMDkKUldRSkc0Mzh1aWZzcVBpOEFuMjdhVnJ2VkN0Tm9OTnVvOHhrZVVZV0VrNWhZNTcwdjZScU9nVUwK",
      "endpoints": [
        "https://github.com/thepateyy/patycord/releases/latest/download/latest.json"
      ]
    }
  }
}
