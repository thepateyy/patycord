{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "patycord",
  "version": "0.1.0",
  "identifier": "com.patycord.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "patycord",
        "width": 1040,
        "height": 600,
        "minWidth": 760,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://*.peerjs.com wss://*.peerjs.com; media-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
